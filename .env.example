# Copy this file to .env before the first launch.
DB_PASSWORD=replace-with-a-long-random-password
BACKUP_DIRECTORY=./backups
BACKUP_ENABLED=true
# Daily at 02:00 in Asia/Tokyo. Six-field Spring cron syntax.
BACKUP_CRON=0 0 2 * * *

# Used only by docker-compose.server.yml.
APP_DOMAIN=hotel.example.com
PUBLIC_BASE_URL=https://hotel.example.com/jukai-internal
# Trust forwarding headers only in the Caddy-based server deployment.
SERVER_FORWARD_HEADERS_STRATEGY=native

# Enable after an SMTP account has been selected.
BOOKING_MAIL_ENABLED=false
BOOKING_MAIL_FROM=
BOOKING_ADMIN_MAIL=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# docker-compose.server.yml requires Turnstile for public submissions.
TURNSTILE_REQUIRED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
