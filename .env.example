# Copy this file to .env before the first launch.
DB_PASSWORD=replace-with-a-long-random-password
BACKUP_DIRECTORY=./backups
BACKUP_ENABLED=true
# Daily at 02:00 in Asia/Tokyo. Six-field Spring cron syntax.
BACKUP_CRON=0 0 2 * * *

# Used only by docker-compose.server.yml.
APP_DOMAIN=hotel.example.com
